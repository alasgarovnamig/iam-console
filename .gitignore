# EN: Local .env files are not committed; the template (.env.example) is.
.env
.env.*
!.env.example
*.local

# --- Test çıktıları / Test artifacts --------------------------------------------
coverage/
# TR: Playwright E2E raporları ve trace'leri. / EN: Playwright E2E reports and traces.
playwright-report/
test-results/
blob-report/
playwright/.cache/

# NOT / NOTE: src/api/schema.d.ts BİLEREK commit'lenir — sözleşmeden üretilir ve
# `npm run contract:check` güncel olduğunu doğrular. / is committed ON PURPOSE.

